{
  "buildCommand": "bash scripts/build-public-site.sh",
  "outputDirectory": "public-site",
  "redirects": [
    { "source": "/illustrated-journey-dashboard.html", "destination": "/", "permanent": false },
    { "source": "/:lang(fr|pt)/illustrated-journey-dashboard.html", "destination": "/:lang/", "permanent": false },
    { "source": "/es", "destination": "/", "permanent": false },
    { "source": "/es/", "destination": "/", "permanent": false },
    { "source": "/es/:path*", "destination": "/", "permanent": false }
  ]
}
